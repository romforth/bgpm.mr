#!/usr/bin/perl -w
use strict;

my $suf='';
while (<>) {
	/^$/ and print and next;
	s/\S*(\s*\b\/\/.*)// and $suf=$1;
	s/\s+\:\:\s+proc//;
	if (/(.*,.*)=(.*,.*)/) {
		my ($l,$r)=($1,$2);
		my $ls=[split(/\,/, $l)];
		my $rs=[split(/\,/, $l)];
		for my $i (shift @$ls) {
			my $j=shift @$rs;
			print "$i = $j; ";
		}
		print "\n";
		next;
	}
	s/(\w+)\s+\:\=\s+/int $1 = /g;
	s/(\s+\})$/;$1/;
	s/\)$/\);/;
	s/(\d)$/$1;/;
	s/if\s+(.*)\s+{/if \($1\) {/;
	print "$_$suf";
	$suf='';
}
