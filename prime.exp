{prime n} => the nth prime number.

{isprime 2 2}   = yes
{isprime 2 3}   = yes
{isprime 2 4}   = no
{isprime 2 5}   = yes
{isprime 2 6}   = no
{isprime 2 9}   = no
{isprime 2 197} = yes
{isprime 2 541} = yes


{prime 1}   => 2
{prime 2}   => 3
{prime 3}   => 5
{prime 10}  => 29
{prime 20}  => 71
{prime 30}  => 113
{prime 40}  => 173
{prime 50}  => 229
{prime 60}  => 281
{prime 70}  => 349
{prime 80}  => 409
{prime 90}  => 463
{prime 100} => 541

